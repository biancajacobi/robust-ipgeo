# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# macOS
.DS_Store

# Secrets — never commit real credentials; only .env.example is tracked
.env
*.env
!.env.example

# Local databases / raw caches (size / licensing); regenerate via data/fetch_*.py
data/db/
data/cache/raw/
data/cache/sources_raw*.jsonl

# Raw Giga API pages (unpseudonymized school IPs — never commit)
data/cache/giga_measurements_raw*.jsonl

# RIR delegation snapshots, ~50 MB per date, fetched on demand by maltego/registry.py
data/cache/rir/

# RDAP per-IP cache of data/fetch_rdap_country.py (carries the queried IPs — never commit)
data/cache/rdap_country_cache.jsonl

# Per-dataset suite outputs: per-case tables carry IPs and stay local; the two IP-free
# probe summaries used by the dashboard are tracked. Result figures are tracked.
eval/out_*/*
!eval/out_probes/probes_by_tag.csv
!eval/out_probes/probes_vs_anchors.csv

# Result figures/archives are regenerated; CSV result tables ARE tracked
*.zip