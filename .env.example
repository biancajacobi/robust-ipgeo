# Template for local credentials used by the LITE-DB downloads.
# Usage: copy this file to `.env` and fill in the real values.
# `.env` is gitignored — real keys never end up in the repo.

# MaxMind GeoLite2 — account ID + license key
#   create/retrieve at https://www.maxmind.com/en/accounts/current/license-key
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# IP2Location LITE — optional download token (https://www.ip2location.com/file-download)
#   leave empty if the DB5 LITE BIN is downloaded manually and placed under data/db/
IP2LOCATION_TOKEN=
IP2LOCATION_DOWNLOAD_TOKEN=

# optional; ipinfo läuft auch ohne (rate-limitiert)
IPINFO_TOKEN=     