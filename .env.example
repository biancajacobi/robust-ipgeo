# Local credentials — copy to `.env` in the repo root and fill in.
# `.env` is gitignored; NEVER commit real keys. Real environment variables
# take precedence over this file (convenient for CI/headless runs).
#
# All keys are optional: the pipeline skips sources whose key is missing
# (fetch scripts report which ones). No keys ship with this repository.

# --- Local geolocation databases (data/fetch_geodbs.py) ---------------------
# MaxMind GeoLite2 (free account: https://www.maxmind.com/en/geolite2/signup)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# IP2Location LITE (free account: https://lite.ip2location.com/)
IP2LOCATION_TOKEN=
IP2LOCATION_DOWNLOAD_TOKEN=

# --- Web sources (data/fetch_sources.py) ------------------------------------
# ipinfo.io token (free tier suffices for small runs)
IPINFO_TOKEN=
# ipwhois.pro key (optional): switches the ipwho.is line to the paid endpoint
# with a higher quota — same data basis, same provider line (verified
# coordinate-identical on sampled IPs); leave empty to use free ipwho.is.
IPWHOISIO=

# --- UNICEF Giga school-connectivity data (data/fetch_giga.py) ---------------
# Both keys are issued via the Giga API portals (https://maps.giga.global/).
# Data: ODbL — Source: Giga (UNICEF) and contributors.
GIGA_METER_API_KEY=
GIGA_API_KEY=

# --- Dataset switch (no credential) ------------------------------------------
# Select the working dataset for fetch/eval scripts, e.g.:
#   GEOIP_DATASET=probes_pool python experiments/run_probes_suite.py
# (usually passed per command rather than set here)
# GEOIP_DATASET=
